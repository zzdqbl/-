<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <!-- 核心包信息 -->
  <name>ylc_nav</name>
  <version>0.0.1</version>
  <description>YLC Navigation (Python launch + C++ base support)</description>
  <maintainer email="root@todo.todo">root</maintainer>
  <license>Apache-2.0</license>

  <!-- 构建工具依赖（C++ + Python 通用） -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <!-- C++ 核心依赖（保留基础，便于扩展） -->
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>nav2_msgs</depend>
  <depend>nav2_core</depend>

  <!-- Python 运行时依赖（launch + 行为树） -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>py_trees</exec_depend>
  <exec_depend>py_trees_ros</exec_depend>
  <!-- launch 调用其他导航包的运行时依赖 -->
  <exec_depend>wheeltec_nav2</exec_depend>

  <!-- 测试依赖 -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <!-- 导出配置：仅保留标准的 build_type，移除非标准的 Python 包声明 -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>