<!--
  彻底禁止重规划、禁止倒退、禁止等待、禁止Spin
  多点导航专用 | 只冲，卡了就清代价地图，绝不重新规划路径
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="0" name="NavigateRecovery">
      <PipelineSequence name="NavigateOnceNoReplan">

        <!-- 👇 修复：必须先删除已走过的点，再计算路径 -->
        <RecoveryNode number_of_retries="0" name="ComputePathThroughPoses">
          <!-- 用 Sequence 包裹2个节点，遵守 RecoveryNode 规则 -->
          <Sequence>
            <RemovePassedGoals input_goals="{goals}" output_goals="{goals}" radius="0.6"/>
            <ComputePathThroughPoses goals="{goals}" path="{path}" planner_id="GridBased"/>
          </Sequence>
          <ClearEntireCostmap name="GlobalClear" service_name="global_costmap/clear_entirely_global_costmap"/>
        </RecoveryNode>

        <RecoveryNode number_of_retries="0" name="FollowPath">
          <FollowPath path="{path}" controller_id="FollowPath"/>
          <ClearEntireCostmap name="LocalClear" service_name="local_costmap/clear_entirely_local_costmap"/>
        </RecoveryNode>

      </PipelineSequence>

      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <Sequence name="OnlyClearCostmap">
          <ClearEntireCostmap service_name="local_costmap/clear_entirely_local_costmap"/>
          <ClearEntireCostmap service_name="global_costmap/clear_entirely_global_costmap"/>
        </Sequence>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
